# =====================================================================
# AZ Labs — required environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# =====================================================================

# ── Supabase (get from: Supabase Dashboard > Project > Settings > API) ───────
# Public (safe in the browser — these are exposed in the JS bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. MUST NOT have NEXT_PUBLIC_ prefix. Set in Vercel > Settings > Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Site URL ─────────────────────────────────────────────────────────────────
# In development: http://localhost:3000
# In production:  https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://azlabs.pro

# ── Ordering gate ─────────────────────────────────────────────────────────────
# Set to "true" only after a qualified adviser has confirmed the VAT and shipping
# rules in src/lib/products-data.ts. While false the order API refuses all orders.
TAX_RULES_VERIFIED=false

# ── Local dev preview (optional) ─────────────────────────────────────────────
# Uncomment to redirect the homepage to the private admin preview in `npm run dev`.
# Has NO effect in production. Useful for previewing the full catalogue locally.
# LOCAL_PREVIEW=true
